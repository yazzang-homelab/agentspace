+type BrowserClipboardBindings = {
+  beginClipboardTransaction?: (
+    content: ClipboardContent,
+  ) => Promise<{ transactionId?: string; error?: string }>;
+  finishClipboardTransaction?: (
+    transactionId: string,
+  ) => Promise<ClipboardTransactionStatus | { error?: string }>;
+};
+
+/**
+ * agentspace keeps the clipboard inside the browser that receives the
+ * paste: X11 and Wayland sessions share it with the desktop, and headless
+ * browsers have their own. The browser saves the previous value and restores
+ * it unless another writer changed the clipboard during the paste.
+ */
+async function beginBrowserClipboardTransaction(
+  input: ClipboardInput,
+): Promise<ClipboardTransaction> {
+  const ego = (globalThis as { ego?: BrowserClipboardBindings }).ego;
+  if (
+    typeof ego?.beginClipboardTransaction !== "function" ||
+    typeof ego.finishClipboardTransaction !== "function"
+  ) {
+    throw new Error(
+      "page.keyboard.paste on Linux requires agentspace clipboard bindings; use page.keyboard.insertText() for plain text",
+    );
+  }
+  const content = typeof input === "string" ? { text: input } : input;
+  const begun = await ego.beginClipboardTransaction(content);
+  if (!begun || typeof begun.transactionId !== "string") {
+    throw new Error(begun?.error || "could not prepare the browser clipboard");
+  }
+  const transactionId = begun.transactionId;
+  let finished = false;
+  return {
+    async finish() {
+      if (finished) throw new Error("clipboard transaction already finished");
+      finished = true;
+      const result = await ego.finishClipboardTransaction!(transactionId);
+      if (result === "restored" || result === "changed") return result;
+      throw new Error(
+        (result as { error?: string })?.error ||
+          "could not restore the browser clipboard",
+      );
+    },
+  };
+}
