+test("Linux paste uses the browser clipboard bindings", async () => {
+  const previous = globalThis.ego;
+  const calls = [];
+  globalThis.ego = {
+    async beginClipboardTransaction(content) {
+      calls.push(["begin", content]);
+      return { transactionId: "t1" };
+    },
+    async finishClipboardTransaction(id) {
+      calls.push(["finish", id]);
+      return "restored";
+    },
+  };
+  try {
+    const transaction = await __testing.beginNativeClipboardTransaction(
+      { text: "a", html: "<b>a</b>" },
+      "linux",
+    );
+    assert.equal(await transaction.finish(), "restored");
+    await assert.rejects(() => transaction.finish(), /already finished/);
+    assert.deepEqual(calls, [
+      ["begin", { text: "a", html: "<b>a</b>" }],
+      ["finish", "t1"],
+    ]);
+    delete globalThis.ego;
+    await assert.rejects(
+      () => __testing.beginNativeClipboardTransaction("a", "linux"),
+      /requires agentspace clipboard bindings.*insertText/,
+    );
+  } finally {
+    if (previous === undefined) delete globalThis.ego;
+    else globalThis.ego = previous;
+  }
+});
